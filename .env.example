# ---- LLM ----
# Provider preset: deepseek | openai | anthropic | qwen | moonshot | gemini | openrouter | ollama | custom
ECHO_PROVIDER=deepseek
# ECHO_MODEL=deepseek-flash          # override the preset's default model
# ECHO_BASE_URL=                    # override the API endpoint (required for "custom")
# ECHO_API_KEY=                     # fallback key when the provider-specific one is unset
# ECHO_LANGUAGE=Chinese             # report language (default: same as the comments)

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ---- Sources ----
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Optional: browser cookie for Bilibili if requests get blocked (-352)
# BILIBILI_COOKIE=
