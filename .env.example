# ---- LLM ----
# Provider preset: deepseek | openai | anthropic | qwen | moonshot | gemini | openrouter | ollama | custom
ECHO_PROVIDER=deepseek
# ECHO_MODEL=deepseek-flash          # override the preset's default model
# ECHO_BASE_URL=                    # override the API endpoint (required for "custom")
# ECHO_API_KEY=                     # fallback key when the provider-specific one is unset
# ECHO_LANGUAGE=Chinese             # report language (default: same as the comments)

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ---- Sources ----
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Bilibili browser cookie (must include SESSDATA). Required to list all videos of an account.
# BILIBILI_COOKIE=

# ---- Local workspace (sync / RAG / memory) ----
# DATABASE_URL=postgresql+psycopg://echo:echo@localhost:5433/echo
# ECHO_EMBEDDER=ollama              # ollama | openai
# ECHO_EMBED_MODEL=bge-m3           # must produce 1024-dim vectors
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Memory (mem0) ----
# ECHO_MEMORY=on                    # off to disable mem0 entirely
# ECHO_MEMORY_INFER=false           # true: let mem0 extract/merge facts instead of storing summaries verbatim
# ECHO_HOME=~/.echo                 # mem0 history database location
